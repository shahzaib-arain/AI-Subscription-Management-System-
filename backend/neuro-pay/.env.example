# Copy this file to `.env` (already gitignored) and fill in real values.
# application.yml reads these via Spring's ${VAR} placeholder resolution —
# see spring.config.import at the top of that file.

DB_PASSWORD=

# Gmail App Password (not your Google account password) — generate one at
# https://myaccount.google.com/apppasswords. Append any extra character to
# this value to deliberately disable outgoing email during local dev.
MAIL_USERNAME=
MAIL_PASSWORD=

# A random base64 string, 48+ bytes decoded (HS384 needs >= 384 bits).
# Generate one with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(48)).decode())"
JWT_SECRET_KEY=
